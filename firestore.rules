rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Root Owner Hash Invariant: verified on the server without exposing in public docs
    function isRootOwnerSeeded() {
      return exists(/databases/$(database)/documents/auth_hashes/493280c790a2a988171849d2f24d47458732a4f59907d700222668162c6f275c);
    }

    // Validation Helpers
    function isValidAuthHashRecord(data) {
      return data.keys().hasAll(['id', 'profileId', 'role']) &&
        data.keys().hasOnly(['id', 'profileId', 'role']) &&
        data.id is string && data.id.size() >= 32 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.profileId is string && data.profileId.size() >= 1 && data.profileId.size() <= 128 && data.profileId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.role is string && data.role.size() <= 16 &&
        (data.role == 'owner' || data.role == 'admin' || data.role == 'manager' || data.role == 'hr' || data.role == 'employee');
    }

    function isValidStaffProfile(data) {
      return data.keys().hasAll([
          'id', 'username', 'displayName', 'role', 'cid',
          'rankNumber', 'rankName', 'department', 'walletBalance',
          'rock', 'wood', 'blueFlower', 'redFlower', 'pinkFlower', 'totalEarned',
          'assignedVehicle', 'status', 'bioNotes', 'joinedAt', 'lastActive'
        ]) &&
        data.keys().hasOnly([
          'id', 'username', 'displayName', 'role', 'cid',
          'rankNumber', 'rankName', 'department', 'walletBalance',
          'rock', 'wood', 'blueFlower', 'redFlower', 'pinkFlower', 'totalEarned',
          'assignedVehicle', 'status', 'bioNotes', 'joinedAt', 'lastActive'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.username is string && data.username.size() >= 1 && data.username.size() <= 64 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 64 &&
        data.role is string && data.role.size() <= 16 &&
        (data.role == 'owner' || data.role == 'admin' || data.role == 'manager' || data.role == 'hr' || data.role == 'employee') &&
        data.cid is string && data.cid.size() >= 1 && data.cid.size() <= 32 &&
        data.rankNumber is number && data.rankNumber >= 1 && data.rankNumber <= 11 &&
        data.rankName is string && data.rankName.size() >= 1 && data.rankName.size() <= 64 &&
        data.department is string && data.department.size() >= 1 && data.department.size() <= 64 &&
        data.walletBalance is number && data.walletBalance >= 0 &&
        data.rock is number && data.rock >= 0 &&
        data.wood is number && data.wood >= 0 &&
        data.blueFlower is number && data.blueFlower >= 0 &&
        data.redFlower is number && data.redFlower >= 0 &&
        data.pinkFlower is number && data.pinkFlower >= 0 &&
        data.totalEarned is number && data.totalEarned >= 0 &&
        data.assignedVehicle is string && data.assignedVehicle.size() >= 1 && data.assignedVehicle.size() <= 120 &&
        data.status is string && data.status.size() <= 16 && (data.status == 'on_shift' || data.status == 'off_duty') &&
        data.bioNotes is string && data.bioNotes.size() <= 500 &&
        data.joinedAt is string && data.joinedAt.size() <= 32 &&
        data.lastActive is string && data.lastActive.size() <= 64;
    }

    function isValidStaffSecret(data) {
      return data.keys().hasAll(['id', 'profileId', 'phone', 'discord', 'pin', 'credHash']) &&
        data.keys().hasOnly(['id', 'profileId', 'phone', 'discord', 'pin', 'credHash']) &&
        data.id is string && data.id.size() >= 16 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.profileId is string && data.profileId.size() >= 1 && data.profileId.size() <= 128 && data.profileId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.phone is string && data.phone.size() >= 1 && data.phone.size() <= 64 &&
        data.discord is string && data.discord.size() >= 1 && data.discord.size() <= 64 &&
        data.pin is string && data.pin.size() >= 1 && data.pin.size() <= 32 &&
        data.credHash is string && data.credHash.size() >= 32 && data.credHash.size() <= 128;
    }

    function isValidCorpState(data) {
      return data.keys().hasAll([
          'treasuryBalance', 'weeklyGain', 'rock', 'wood',
          'blueFlower', 'redFlower', 'pinkFlower', 'totalEarned',
          'activeWorkersCount', 'radioFrequency'
        ]) &&
        data.keys().hasOnly([
          'treasuryBalance', 'weeklyGain', 'rock', 'wood',
          'blueFlower', 'redFlower', 'pinkFlower', 'totalEarned',
          'activeWorkersCount', 'radioFrequency'
        ]) &&
        data.treasuryBalance is number && data.treasuryBalance >= 0 &&
        data.weeklyGain is number && data.weeklyGain >= 0 &&
        data.rock is number && data.rock >= 0 &&
        data.wood is number && data.wood >= 0 &&
        data.blueFlower is number && data.blueFlower >= 0 &&
        data.redFlower is number && data.redFlower >= 0 &&
        data.pinkFlower is number && data.pinkFlower >= 0 &&
        data.totalEarned is number && data.totalEarned >= 0 &&
        data.activeWorkersCount is number && data.activeWorkersCount >= 0 &&
        data.radioFrequency is string && data.radioFrequency.size() >= 1 && data.radioFrequency.size() <= 64;
    }

    function isValidVehicleItem(data) {
      return data.keys().hasAll([
          'id', 'modelName', 'category', 'trunkKg',
          'rankRequired', 'slot', 'status', 'fuelPercent', 'plate',
          'publicVisible', 'publicImage', 'publicDesc'
        ]) &&
        data.keys().hasOnly([
          'id', 'modelName', 'category', 'trunkKg',
          'rankRequired', 'slot', 'status', 'fuelPercent', 'plate',
          'publicVisible', 'publicImage', 'publicDesc'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.modelName is string && data.modelName.size() >= 1 && data.modelName.size() <= 80 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.trunkKg is number && data.trunkKg >= 0 &&
        data.rankRequired is string && data.rankRequired.size() >= 1 && data.rankRequired.size() <= 64 &&
        data.slot is string && data.slot.size() >= 1 && data.slot.size() <= 64 &&
        data.status is string && data.status.size() <= 32 &&
        (data.status == 'Готов к выезду' || data.status == 'В рейсе' || data.status == 'Ремонт' || data.status == 'Зарезервирован' || data.status == 'Дежурство СБ') &&
        data.fuelPercent is number && data.fuelPercent >= 0 && data.fuelPercent <= 100 &&
        data.plate is string && data.plate.size() >= 1 && data.plate.size() <= 32 &&
        data.publicVisible is bool &&
        // Карточка авто для публички: data-URL сжимается порталом до ~900 КБ.
        data.publicImage is string && data.publicImage.size() <= 950000 &&
        (data.publicImage == '' || data.publicImage.matches('^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+$')) &&
        data.publicDesc is string && data.publicDesc.size() <= 500;
    }

    function isValidHallOfFameEntry(data) {
      return data.keys().hasAll(['id', 'place', 'nickname', 'cid', 'rankTitle', 'totalMined', 'bonusReward']) &&
        data.keys().hasOnly(['id', 'place', 'nickname', 'cid', 'rankTitle', 'totalMined', 'bonusReward']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.place is number && data.place >= 1 && data.place <= 3 &&
        data.nickname is string && data.nickname.size() >= 1 && data.nickname.size() <= 64 &&
        data.cid is string && data.cid.size() >= 1 && data.cid.size() <= 32 &&
        data.rankTitle is string && data.rankTitle.size() >= 1 && data.rankTitle.size() <= 64 &&
        data.totalMined is number && data.totalMined >= 0 &&
        data.bonusReward is number && data.bonusReward >= 0;
    }

    function isValidBonusReport(data) {
      return data.keys().hasAll([
          'id', 'userId', 'nickname', 'cid', 'rankTitle',
          'rock', 'wood', 'blueFlower', 'redFlower', 'pinkFlower',
          'totalMinedItems', 'requestedAmount', 'comment', 'createdAt', 'status'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'nickname', 'cid', 'rankTitle',
          'rock', 'wood', 'blueFlower', 'redFlower', 'pinkFlower',
          'totalMinedItems', 'requestedAmount', 'comment', 'createdAt', 'status'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.nickname is string && data.nickname.size() >= 1 && data.nickname.size() <= 64 &&
        data.cid is string && data.cid.size() >= 1 && data.cid.size() <= 32 &&
        data.rankTitle is string && data.rankTitle.size() >= 1 && data.rankTitle.size() <= 64 &&
        data.rock is number && data.rock >= 0 &&
        data.wood is number && data.wood >= 0 &&
        data.blueFlower is number && data.blueFlower >= 0 &&
        data.redFlower is number && data.redFlower >= 0 &&
        data.pinkFlower is number && data.pinkFlower >= 0 &&
        data.totalMinedItems is number && data.totalMinedItems >= 0 &&
        data.requestedAmount is number && data.requestedAmount >= 0 &&
        data.comment is string && data.comment.size() >= 1 && data.comment.size() <= 500 &&
        data.createdAt is string && data.createdAt.size() >= 1 && data.createdAt.size() <= 64 &&
        data.status is string && data.status.size() <= 16 &&
        (data.status == 'pending' || data.status == 'approved' || data.status == 'counted' || data.status == 'rejected');
    }

    // Applicant PII arrives from the unauthenticated public portal, so every field is
    // pattern-checked here: the collection is otherwise a public write endpoint.
    function isValidApplication(data) {
      return data.keys().hasAll([
          'id', 'nick', 'cid', 'phone', 'discord', 'docs',
          'status', 'submittedAt', 'source', 'reviewedAt', 'reviewerNotes', 'createdProfileId'
        ]) &&
        // publicCode опционально: у заявок, отправленных до появления кодов, его нет.
        data.keys().hasOnly([
          'id', 'nick', 'cid', 'phone', 'discord', 'docs',
          'status', 'submittedAt', 'source', 'reviewedAt', 'reviewerNotes', 'createdProfileId',
          'publicCode'
        ]) &&
        isValidId(data.id) &&
        data.nick is string && data.nick.size() >= 2 && data.nick.size() <= 64 &&
        data.nick.matches("^[A-Za-zА-Яа-яЁё0-9_\\.\\- ]+$") &&
        data.cid is string && data.cid.size() >= 1 && data.cid.size() <= 32 && data.cid.matches('^[A-Za-z0-9]+$') &&
        data.phone is string && data.phone.size() >= 1 && data.phone.size() <= 64 && data.phone.matches('^[0-9\\-\\+ ]+$') &&
        data.discord is string && data.discord.size() >= 2 && data.discord.size() <= 64 &&
        data.docs is string && data.docs.size() >= 12 && data.docs.size() <= 300 && data.docs.matches('^https://[^\\s]+$') &&
        data.status is string && data.status.size() <= 16 &&
        (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected') &&
        data.submittedAt is string && data.submittedAt.size() >= 10 && data.submittedAt.size() <= 64 &&
        data.source is string && data.source.size() >= 1 && data.source.size() <= 32 && data.source.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.reviewedAt is string && data.reviewedAt.size() <= 64 &&
        data.reviewerNotes is string && data.reviewerNotes.size() <= 500 &&
        data.createdProfileId is string && data.createdProfileId.size() <= 128 &&
        (data.createdProfileId == '' || data.createdProfileId.matches('^[a-zA-Z0-9_\\-]+$')) &&
        (!data.keys().hasAny(['publicCode']) ||
          (data.publicCode is string && data.publicCode.size() == 9 && data.publicCode.matches('^AP-[A-Z0-9]{6}$')));
    }

    function isValidAuditLogItem(data) {
      return data.keys().hasAll([
          'id', 'timestamp', 'actorId', 'actorName',
          'actorRole', 'module', 'action', 'details'
        ]) &&
        data.keys().hasOnly([
          'id', 'timestamp', 'actorId', 'actorName',
          'actorRole', 'module', 'action', 'details'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.timestamp is string && data.timestamp.size() >= 1 && data.timestamp.size() <= 64 &&
        data.actorId is string && data.actorId.size() >= 1 && data.actorId.size() <= 128 &&
        data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 64 &&
        data.actorRole is string && data.actorRole.size() <= 16 &&
        (data.actorRole == 'owner' || data.actorRole == 'admin' || data.actorRole == 'manager' || data.actorRole == 'hr' || data.actorRole == 'employee') &&
        data.module is string && data.module.size() <= 32 &&
        (data.module == 'users' || data.module == 'treasury' || data.module == 'fleet' || data.module == 'hall_of_fame' || data.module == 'recruitment' || data.module == 'farm' || data.module == 'profile' || data.module == 'bonus_report') &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 120 &&
        data.details is string && data.details.size() >= 1 && data.details.size() <= 500;
    }

    // Collection 1: /auth_hashes/{credHash}
    // Zero-knowledge lookup: allow get ONLY if exact 64-char SHA-256 hash is known; list is STRICTLY FORBIDDEN!
    match /auth_hashes/{credHash} {
      allow get: if isValidId(credHash) && credHash.size() >= 32;
      allow list: if false;
      allow create: if isValidId(credHash) && isValidAuthHashRecord(incoming()) && incoming().id == credHash && (
        credHash == '493280c790a2a988171849d2f24d47458732a4f59907d700222668162c6f275c' ||
        isRootOwnerSeeded()
      );
      allow update: if isValidId(credHash) && isValidAuthHashRecord(incoming()) &&
        incoming().id == existing().id &&
        isRootOwnerSeeded() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['role', 'profileId']);
      allow delete: if isValidId(credHash) && isRootOwnerSeeded();
    }

    // Collection 2: /staff_profiles/{profileId} (Non-PII operational profiles: NO PIN, NO PHONE, NO DISCORD, NO HASH)
    match /staff_profiles/{profileId} {
      allow get: if isValidId(profileId) && existing().id == profileId;
      allow list: if existing().rankNumber >= 1;
      allow create: if isValidId(profileId) && isValidStaffProfile(incoming()) && incoming().id == profileId && (
        profileId == 'u-owner-root' || isRootOwnerSeeded()
      );
      allow update: if isValidId(profileId) && isValidStaffProfile(incoming()) &&
        incoming().id == existing().id &&
        incoming().joinedAt == existing().joinedAt &&
        isRootOwnerSeeded() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'role', 'cid', 'rankNumber', 'rankName', 'department',
          'walletBalance', 'rock', 'wood', 'blueFlower', 'redFlower', 'pinkFlower',
          'totalEarned', 'assignedVehicle', 'status', 'bioNotes', 'lastActive'
        ]);
      allow delete: if isValidId(profileId) && profileId != 'u-owner-root' && isRootOwnerSeeded();
    }

    // Collection 3: /staff_secrets/{secretId}
    // Isolated PII & PIN vault: keyed by secret token derived from Owner's hash. LIST IS FORBIDDEN!
    match /staff_secrets/{secretId} {
      allow get: if isValidId(secretId) && secretId.size() >= 16;
      allow list: if false;
      allow create: if isValidId(secretId) && isValidStaffSecret(incoming()) && incoming().id == secretId && isRootOwnerSeeded();
      allow update: if isValidId(secretId) && isValidStaffSecret(incoming()) &&
        incoming().id == existing().id &&
        isRootOwnerSeeded() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['phone', 'discord', 'pin', 'credHash']);
      allow delete: if isValidId(secretId) && isRootOwnerSeeded();
    }

    // Collection 4: /corp_state/{stateId}
    match /corp_state/{stateId} {
      allow get: if isValidId(stateId) && existing().treasuryBalance >= 0;
      allow list: if existing().treasuryBalance >= 0;
      allow create: if isValidId(stateId) && isValidCorpState(incoming()) && isRootOwnerSeeded();
      allow update: if isValidId(stateId) && isValidCorpState(incoming()) &&
        isRootOwnerSeeded() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'treasuryBalance', 'weeklyGain', 'rock', 'wood',
          'blueFlower', 'redFlower', 'pinkFlower', 'totalEarned',
          'activeWorkersCount', 'radioFrequency'
        ]);
      allow delete: if false;
    }

    // Collection 5: /fleet/{vehicleId}
    match /fleet/{vehicleId} {
      allow get: if isValidId(vehicleId) && existing().id == vehicleId;
      allow list: if existing().trunkKg >= 0;
      allow create: if isValidId(vehicleId) && isValidVehicleItem(incoming()) && incoming().id == vehicleId && isRootOwnerSeeded();
      allow update: if isValidId(vehicleId) && isValidVehicleItem(incoming()) &&
        incoming().id == existing().id &&
        isRootOwnerSeeded() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['modelName', 'category', 'trunkKg', 'rankRequired', 'slot', 'status', 'fuelPercent', 'plate', 'publicVisible', 'publicImage', 'publicDesc']);
      allow delete: if isValidId(vehicleId) && isRootOwnerSeeded();
    }

    // Collection 6: /hall_of_fame/{entryId}
    match /hall_of_fame/{entryId} {
      allow get: if isValidId(entryId) && existing().id == entryId;
      allow list: if existing().place >= 1;
      allow create: if isValidId(entryId) && isValidHallOfFameEntry(incoming()) && incoming().id == entryId && isRootOwnerSeeded();
      allow update: if isValidId(entryId) && isValidHallOfFameEntry(incoming()) &&
        incoming().id == existing().id &&
        incoming().place == existing().place &&
        isRootOwnerSeeded() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['nickname', 'cid', 'rankTitle', 'totalMined', 'bonusReward']);
      allow delete: if isRootOwnerSeeded();
    }

    // Collection 7: /bonus_reports/{reportId}
    match /bonus_reports/{reportId} {
      allow get: if isValidId(reportId) && existing().requestedAmount >= 0;
      allow list: if existing().requestedAmount >= 0;
      allow create: if isValidId(reportId) && isValidBonusReport(incoming()) &&
        incoming().id == reportId &&
        incoming().status == 'pending' &&
        exists(/databases/$(database)/documents/staff_profiles/$(incoming().userId));
      allow update: if isValidId(reportId) && isValidBonusReport(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        isRootOwnerSeeded() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isValidId(reportId) && isRootOwnerSeeded();
    }

    // Collection 8: /audit_logs/{logId}
    // ВАЖНО: list-правило обязано повторять условие запроса портала (where timestamp >= '0'),
    // иначе Firestore не может доказать безопасность выборки и отклоняет весь list.
    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && existing().timestamp.size() >= 1;
      allow list: if existing().timestamp >= '0';
      allow create: if isValidId(logId) && isValidAuditLogItem(incoming()) &&
        incoming().id == logId &&
        exists(/databases/$(database)/documents/staff_profiles/$(incoming().actorId));
      allow update: if false;
      allow delete: if false;
    }

    // Collection 9: /applications/{appId}
    // Applicant forms pushed by the public portal (Apathy-Corp-Public) and reviewed in the staff portal.
    match /applications/{appId} {      allow get: if isValidId(appId) && existing().id == appId && isRootOwnerSeeded();
      allow list: if existing().id == appId && isRootOwnerSeeded();

      // Public write: pending form only, no review fields.
      allow create: if isValidId(appId) && isValidApplication(incoming()) &&
        incoming().id == appId &&
        incoming().status == 'pending' &&
        incoming().reviewedAt == '' &&
        incoming().reviewerNotes == '' &&
        incoming().createdProfileId == '';

      // Staff review: contact data is frozen and a terminal status can never be reopened.
      allow update: if isValidId(appId) && isValidApplication(incoming()) &&
        incoming().id == existing().id &&
        isRootOwnerSeeded() &&
        existing().status == 'pending' &&
        (incoming().status == 'approved' || incoming().status == 'rejected') &&
        incoming().nick == existing().nick &&
        incoming().cid == existing().cid &&
        incoming().phone == existing().phone &&
        incoming().discord == existing().discord &&
        incoming().docs == existing().docs &&
        incoming().submittedAt == existing().submittedAt &&
        incoming().source == existing().source &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewerNotes', 'createdProfileId']);

      allow delete: if false;
    }

    // Collection 10: /public_stats/main
    // Зеркало публичных цифр («Корпорация в цифрах» на сайте). Читает кто угодно,
    // пишет только портал (без авторизации — модель как у остальных коллекций).
    match /public_stats/{statsId} {
      allow get, list: if isValidId(statsId);
      allow create, update: if isValidId(statsId) &&
        incoming().keys().hasOnly(['treasuryBalance', 'totalMinedItems', 'staffTotal', 'updatedAt']) &&
        incoming().treasuryBalance is number && incoming().treasuryBalance >= 0 &&
        incoming().totalMinedItems is number && incoming().totalMinedItems >= 0 &&
        incoming().staffTotal is number && incoming().staffTotal >= 0 &&
        incoming().updatedAt is string && incoming().updatedAt.size() <= 64;
      allow delete: if false;
    }

    // Collection 11: /public_presence/{profileId}
    // Биконы онлайн-счётчика: {at: ISO}. Id — внутренний id профиля, без PII.
    // TTL-фильтр делает счётчик самозатухающим: старые биконы просто перестают попадать в выборку.
    match /public_presence/{presenceId} {
      allow get, list: if isValidId(presenceId);
      allow create, update: if isValidId(presenceId) &&
        incoming().keys().hasOnly(['at']) &&
        incoming().at is string && incoming().at.size() <= 64;
      allow delete: if isValidId(presenceId);
    }
  }
}
